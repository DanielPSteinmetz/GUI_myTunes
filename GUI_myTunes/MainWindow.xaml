<Window x:Class="GUI_myTunes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_myTunes"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="Play" Executed="PlayCommand_Executed" CanExecute="PlayCommand_CanExecute" />
        <CommandBinding Command="Stop" Executed="StopCommand_Executed" CanExecute="StopCommand_CanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top">
                <ToolBar>
                    <Button Click="ImportMusicButton_Click" ToolTip="Import Music">
                        <Image Source="/Images/newSong.png" Width="30" Height="30"/>
                    </Button>
                    <Button Click="CreatePlaylistButton_Click" ToolTip="Create Playlist">
                        <Image Source="/Images/newPlaylist.png" Width="30" Height="30"/>
                    </Button>
                    <Button Click="InfoButton_Click" ToolTip="About">
                        <Image Source="/Images/info.png" Width="30" Height="30"/>
                    </Button>
                </ToolBar>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Label Content="Filter:"/>
                    <TextBox x:Name="SearchBox"
                         Width="180"
                         Height="25"
                         
                         
                         Margin="0,0,15,0"
                         TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
            </Grid>
            <ListBox x:Name="playlistListBox" DockPanel.Dock="Left" Width="200" SelectionChanged="PlaylistListBox_SelectionChanged"/>
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom">
                    <Button Name="playButton" Content="Play" Command="Play" Width="100" Height="30" Margin="5" ToolTipService.ShowOnDisabled="True"/>
                    <Button Name="stopButton" Content="Stop" Command="Stop" Width="100" Height="30" Margin="5" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
                <DataGrid 
                    SelectionChanged="songsDataGrid_SelectionChanged"
                    Name="songsDataGrid" 
                    AutoGenerateColumns="False" 
                    CanUserAddRows="False" 
                    IsReadOnly="True" 
                    SelectionMode="Single" 
                >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title"  Binding="{Binding title}"  Width="*" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding artist}" Width="*" />
                        <DataGridTextColumn Header="Album"  Binding="{Binding album}"  Width="*" />
                        <DataGridTextColumn Header="Genre"  Binding="{Binding genre}"  Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
