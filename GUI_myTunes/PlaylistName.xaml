<Window x:Class="GUI_myTunes.PlaylistName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_myTunes"
        mc:Ignorable="d"
        Title="Playlist Name" Height="250" Width="300">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Vertical">
            <Label Content="Enter playlist name:"></Label>
            <TextBox/>

            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="OK" Margin="10"/>
                <Button Content="Cancel" Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
